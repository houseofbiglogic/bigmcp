<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="category" model="ir.module.category">
        <field name="name">MCP Server</field>
        <field name="sequence">998</field>
    </record>

    <record id="privileges" model="res.groups.privilege">
        <field name="name">MCP Role</field>
        <field name="category_id" ref="bigmcp.category"/>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">MCP User</field>
        <field name="privilege_id" ref="bigmcp.privileges"/>
        <field name="comment">Can connect to the /mcp endpoint with an API key; Odoo access rights still apply to every call.</field>
    </record>

    <record id="group_admin" model="res.groups">
        <field name="name">MCP Admin</field>
        <field name="privilege_id" ref="bigmcp.privileges"/>
        <field name="implied_ids" eval="[(4, ref('bigmcp.group_user'))]"/>
        <field name="comment">Manages the notes shown to MCP clients.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('bigmcp.group_admin'))]"/>
    </record>

</odoo>
